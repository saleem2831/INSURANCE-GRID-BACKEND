PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/motor_commission_engine
GRID_UPLOAD_DIR=./uploads/grids
# Optional comma-separated frontend origins. Leave blank in local development.
CORS_ORIGINS=

# PDF grids (Chola/IFFCO/United use vector text; National uses OCR fallback)
ENABLE_PDF_OCR=true
PDF_OCR_DPI=110
PDF_OCR_MAX_PAGES=30

# Optional remote PDF fallback. Used only while onboarding grids, never during live payout calculation.
OPENROUTER_API_KEY=
OPENROUTER_PDF_MODEL=openrouter/auto
OPENROUTER_PDF_ENGINE=mistral-ocr
OPENROUTER_PDF_TIMEOUT_MS=180000
OPENROUTER_PDF_MAX_TOKENS=30000
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=Motor Commission Grid Engine

# Bounded async workers
COMPARE_CONCURRENCY=6
PACKAGE_PARSE_CONCURRENCY=3
